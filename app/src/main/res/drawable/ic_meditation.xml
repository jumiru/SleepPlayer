<?xml version="1.0" encoding="utf-8"?>
<!-- Lotus / Meditation Symbol: stilisierter sitzender Mensch mit Aura-Kreis -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Äußerer Kreis (Aura) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M12,2 A10,10 0 1,1 11.99,2 Z" />

    <!-- Kopf -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,5.5 A1.5,1.5 0 1,1 11.99,5.5 Z" />

    <!-- Körper: sitzende Position -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,8.5 L12,13" />

    <!-- Linker Arm / Bein -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,13 L8,15.5" />

    <!-- Rechter Arm / Bein -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,13 L16,15.5" />

    <!-- Verbindungslinie Beine (Lotus-Sitz) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M7,16.5 L17,16.5" />

    <!-- Linke Hand (ruht auf Knie) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.5,16 A0.8,0.8 0 1,1 7.49,16 Z" />

    <!-- Rechte Hand (ruht auf Knie) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.5,16 A0.8,0.8 0 1,1 16.49,16 Z" />

</vector>

